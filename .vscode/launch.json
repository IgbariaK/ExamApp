{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug client only",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/client",
      "preLaunchTask": "run: client only"
    },
    {
      "name": "Debug client with server data",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/client",
      "preLaunchTask": "client: server data"
    },
    {
      "name": "Debug server only",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/src/server.js",
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Debug client + server",
      "configurations": ["Debug server only", "Debug client with server data"],
      "stopAll": true
    }
  ]
}
