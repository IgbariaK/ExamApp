{
  "name": "exam-app",
  "private": true,
  "type": "module",
  "scripts": {
    "client": "npm --prefix client run dev:client",
    "client:server-data": "npm --prefix client run dev:server",
    "server": "npm --prefix server run dev",
    "server:json": "npm --prefix server run dev:json",
    "server:postgres": "npm --prefix server run dev:postgres",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "microservice:up": "docker compose up -d notification-service",
    "microservice:logs": "docker compose logs -f notification-service",
    "microservice:down": "docker compose stop notification-service",
    "db:schema": "npm --prefix server run db:schema",
    "db:seed": "npm --prefix server run db:seed",
    "db:add-single-submission-constraint": "npm --prefix server run db:add-single-submission-constraint",
    "db:test-exam": "npm --prefix server run db:test-exam",
    "db:query-jsonb": "npm --prefix server run db:query-jsonb"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0"
  }
}
