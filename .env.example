# Client data mode: use "client" for browser local storage or "server" for the API.
VITE_DATA_SOURCE=client
VITE_API_BASE_URL=/api

# Express server port.
PORT=3001

# Postgres connection for the JSONB seed/query scripts.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Use "require" for hosted Postgres such as Render.
# Use "disable" only for local Postgres without SSL.
PGSSLMODE=require
