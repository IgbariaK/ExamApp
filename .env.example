# Client data mode: use "client" for browser local storage or "server" for the API.
VITE_DATA_SOURCE=client
VITE_API_BASE_URL=/api

# Express server port.
PORT=3001
# Use "postgres" for PostgreSQL, "json" for a local JSON file, or "memory" for temporary demo data.
# Vercel deployments require DATABASE_URL and never fall back to per-instance memory.
SERVER_DATA_SOURCE=postgres
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
NOTIFICATION_SERVICE_URL=http://localhost:4001
# Optional. In JSON mode, the default local file is data/exam-app-db.json inside the server package.
# JSON_DB_PATH=data/exam-app-db.json

# Postgres connection for the JSONB seed/query scripts.
# The local default below matches docker-compose.yml.
DATABASE_URL=postgres://exam_app:exam_app_password@localhost:5432/exam_app

# Use "require" for hosted PostgreSQL or "disable" for local PostgreSQL without SSL.
PGSSLMODE=disable
